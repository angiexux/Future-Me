# Copy to `.env` for local development (never commit `.env`).
ANTHROPIC_API_KEY=

# Used by `npm start` (production Node server). Defaults to 4173.
# PORT=4173

# Optional — defaults to claude-3-5-sonnet-20241022 if unset.
# VITE_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional — if the SPA is hosted on a different origin than the API proxy, set the API origin (no trailing slash).
# VITE_API_BASE=https://your-backend.example.com
